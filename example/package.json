{
  "name": "expo-pico-example",
  "version": "1.0.0",
  "private": true,
  "main": "./index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --variant mobileDebug",
    "android:pico": "expo run:android --variant picoDebug",
    "android:mobile": "expo run:android --variant mobileDebug",
    "quest": "expo run:android --variant questDebug",
    "quest:release": "expo run:android --variant questRelease",
    "prebuild": "expo prebuild --clean",
    "prebuild:pico": "test -n \"$PICO_APP_ID\" || { echo 'prebuild:pico needs PICO_APP_ID: the app ID the PICO Developer Console issued for com.example.expopico.' >&2; exit 1; } && expo prebuild --clean --platform android --no-install",
    "prebuild:quest": "expo prebuild --clean --platform android --no-install",
    "build:pico": "yarn prebuild:pico && cd android && ./gradlew assemblePicoDebug -PreactNativeArchitectures=arm64-v8a --no-daemon",
    "build:quest": "yarn prebuild:quest && cd android && ./gradlew assembleQuestDebug -PreactNativeArchitectures=arm64-v8a --no-daemon",
    "demo:model": "node scripts/download-demo-model.js --force --verbose",
    "demo:model:clean": "node -e \"require('fs').rmSync(require('path').join('assets','models','pico-demo.glb'), { force: true }); console.log('removed')\"",
    "postinstall": "node scripts/download-demo-model.js --post-install",
    "prepare": "echo 'No prepare needed for example app'",
    "test": "jest --config jest.config.js"
  },
  "dependencies": {
    "@expo-pico/account": "*",
    "@expo-pico/achievements": "*",
    "@expo-pico/app-kit": "*",
    "@expo-pico/core": "*",
    "@expo-pico/iap": "*",
    "@expo-pico/leaderboards": "*",
    "@expo-pico/notifications": "*",
    "@expo-pico/rooms": "*",
    "@expo-pico/rtc": "*",
    "@expo-pico/social": "*",
    "@expo-pico/spatial": "*",
    "@expo-pico/storage": "*",
    "@expo-pico/subscription": "*",
    "@fishjam-cloud/react-native-client": "0.31.0",
    "@fishjam-cloud/react-native-webrtc": "0.31.0",
    "@fishjam-cloud/ts-client": "0.31.0",
    "@metavr/layout-compat": "1.1.0",
    "@metavr/layout-window-compat": "1.1.0",
    "@reactvision/react-viro": "3.0.2",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-horizon-core": "58.0.1",
    "expo-horizon-quest": "*",
    "expo-linking": "~58.0.16",
    "expo-modules-core": "~58.0.30",
    "expo-router": "~58.0.30",
    "nitro-core": "1.0.0-alpha.nightly.120.g33ef045b96c0",
    "react": "19.3.0",
    "react-freeze": "^1.0.4",
    "react-native": "0.88.1",
    "react-native-get-random-values": "2.0.0",
    "react-native-nitro-modules": "1.0.0-alpha.nightly.120.g33ef045b96c0",
    "react-native-permissions": "^5.6.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "react-native-svg-transformer": "^1.5.3"
  }
}
