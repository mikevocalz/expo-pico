{
  "name": "@expo-pico/core",
  "version": "1.0.0",
  "description": "Expo config plugin and runtime module for PICO OS 6 XR devices.",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/src/index.js",
      "require": "./build/src/index.js",
      "types": "./build/src/index.d.ts"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js",
    "./plugin": {
      "import": "./plugin/build/withPico.js",
      "require": "./plugin/build/withPico.js",
      "types": "./plugin/build/withPico.d.ts"
    },
    "./plugin/viro": {
      "import": "./plugin/build/viro/index.js",
      "require": "./plugin/build/viro/index.js",
      "types": "./plugin/build/viro/index.d.ts"
    }
  },
  "bin": {
    "expo-pico-doctor": "./cli/build/doctor.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-pico",
    "pico",
    "pico-os",
    "xr",
    "spatial",
    "vr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mikevocalz/expo-pico.git",
    "directory": "packages/expo-pico-core"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "expo": ">=58.0.0 <59",
    "react": ">=19.3.0 <20",
    "react-native": ">=0.88.0 <0.89",
    "expo-location": "*",
    "react-native-nitro-modules": "*",
    "nitro-core": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": false
    },
    "expo-location": {
      "optional": true
    },
    "nitro-core": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": false
    }
  },
  "files": [
    "LICENSE",
    "build",
    "android",
    "cli/build",
    "plugin/build",
    "plugin/assets",
    "app.plugin.js",
    "nitrogen/generated",
    "expo-module.config.json",
    "android-expo",
    "nitro.json",
    "react-native.config.js"
  ],
  "homepage": "https://github.com/mikevocalz/expo-pico/tree/main/packages/expo-pico-core",
  "bugs": "https://github.com/mikevocalz/expo-pico/issues",
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs"
  },
  "gitHead": "9be55e4ea3cc32e69424c50aa4101a1a9f0cefd1",
  "expoPico": {
    "sourceCommit": "9be55e4ea3cc32e69424c50aa4101a1a9f0cefd1"
  }
}
