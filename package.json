{
  "name": "@expo-pico/achievements",
  "version": "1.0.0",
  "description": "PICO OS achievements for Expo",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js",
    "./plugin": {
      "import": "./plugin/build/src/index.js",
      "require": "./plugin/build/src/index.js",
      "types": "./plugin/build/src/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "plugin": [
        "./plugin/build/src/index.d.ts"
      ]
    }
  },
  "keywords": [
    "expo",
    "pico",
    "xr",
    "achievements",
    "gamification"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mikevocalz/expo-pico.git",
    "directory": "packages/expo-pico-achievements"
  },
  "bugs": "https://github.com/your-org/expo-pico/issues",
  "license": "MIT",
  "homepage": "https://github.com/your-org/expo-pico/packages/expo-pico-achievements",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "expo": ">=58.0.0 <59",
    "@expo-pico/core": ">=1.0.0",
    "react": ">=19.3.0 <20",
    "react-native": ">=0.88.0 <0.89",
    "react-native-nitro-modules": ">=1.0.0-alpha.nightly.120.g33ef045b96c0",
    "nitro-core": ">=1.0.0-alpha.nightly.120.g33ef045b96c0",
    "@expo-pico/platform-service-common": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": false
    },
    "@expo-pico/core": {
      "optional": false
    },
    "nitro-core": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": false
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-pico-achievements"
      ]
    }
  },
  "files": [
    "LICENSE",
    "build",
    "android",
    "plugin/build",
    "app.plugin.js",
    "nitrogen/generated",
    "nitro.json",
    "react-native.config.js"
  ],
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs"
  },
  "gitHead": "853bdad57e665c00e2a63a9f1287fb8102a47cce",
  "expoPico": {
    "sourceCommit": "853bdad57e665c00e2a63a9f1287fb8102a47cce"
  }
}
