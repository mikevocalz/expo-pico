{
  "name": "@expo-pico/core",
  "version": "1.0.0",
  "description": "Expo config plugin and runtime module for PICO OS 6 XR devices.",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/src/index.js",
      "require": "./build/src/index.js",
      "types": "./build/src/index.d.ts"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js",
    "./plugin": {
      "import": "./plugin/build/withPico.js",
      "require": "./plugin/build/withPico.js",
      "types": "./plugin/build/withPico.d.ts"
    },
    "./plugin/viro": {
      "import": "./plugin/build/viro/index.js",
      "require": "./plugin/build/viro/index.js",
      "types": "./plugin/build/viro/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "plugin": [
        "./plugin/build/withPico.d.ts"
      ],
      "plugin/viro": [
        "./plugin/build/viro/index.d.ts"
      ]
    }
  },
  "bin": {
    "expo-pico-doctor": "./cli/build/doctor.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-pico",
    "pico",
    "pico-os",
    "xr",
    "spatial",
    "vr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mikevocalz/expo-pico.git",
    "directory": "packages/expo-pico-core"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "expo": ">=58.0.0 <59",
    "react": ">=19.3.0 <20",
    "react-native": ">=0.88.0 <0.89",
    "expo-location": "*",
    "react-native-nitro-modules": ">=1.0.0-alpha.nightly.120.g33ef045b96c0",
    "nitro-core": ">=1.0.0-alpha.nightly.120.g33ef045b96c0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": false
    },
    "expo-location": {
      "optional": true
    },
    "nitro-core": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": false
    }
  },
  "files": [
    "LICENSE",
    "build",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "android/eskiu-runtime",
    "android/one-launcher-tile.gradle",
    "android/pico-window-positions.gradle",
    "cli/build",
    "plugin/build",
    "plugin/assets",
    "app.plugin.js",
    "nitrogen/generated",
    "expo-module.config.json",
    "android-expo",
    "nitro.json",
    "react-native.config.js"
  ],
  "homepage": "https://github.com/mikevocalz/expo-pico/tree/main/packages/expo-pico-core",
  "bugs": "https://github.com/mikevocalz/expo-pico/issues",
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs"
  },
  "gitHead": "853bdad57e665c00e2a63a9f1287fb8102a47cce",
  "expoPico": {
    "sourceCommit": "853bdad57e665c00e2a63a9f1287fb8102a47cce"
  }
}
