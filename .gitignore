node_modules/
build/
dist/
*.tsbuildinfo
.expo/
*.log
.DS_Store
*.local
plugin/build/
cli/build/
.turbo/
# nitrogen codegen. Regenerated by `nitrogen` (the `build`/`prepare` scripts
# run it), and package.json `files` still ships it, so npm pack picks it up
# even though git ignores it.
packages/*/nitrogen/generated/

# yarn is the package manager (see `packageManager` + .github/workflows).
# A second lockfile drifts silently and is never the one CI resolves from.
bun.lock
package-lock.json

# tsc emit that lands next to sources when a tsconfig outDir is misrooted
packages/*/plugin/src/**/*.js
packages/*/plugin/src/**/*.d.ts
packages/*/cli/src/**/*.js
packages/*/cli/src/**/*.d.ts
packages/*/src/**/*.js
packages/*/src/**/*.d.ts
!packages/__jest_stubs__/**/*.js

# CNG output for the example app. packages/*/android/ is library source — keep it.
example/android/
example/ios/

# Regenerated on postinstall by example/scripts/download-demo-model.js.
example/assets/models/pico-demo.glb

# Proprietary PICO SDK AARs. See vendor/pico-sdk/README.md.
vendor/pico-sdk/*.aar
.vendor/

packages/*/android/.gradle/
packages/*/android/build/
# CMake/NDK scratch. Committing this is how a 1MB "patch" of compiler-id
# binaries and ninja logs got captured once already.
packages/*/android/.cxx/
patch-package-error.json
patch-package-error.json.gz

# Editor and agent state
.claude/
.cursor/
.qodo/
.vscode/
.idea/

.env
.env.local
.env.*.local

# Working docs, not part of the published surface
ARCHITECTURE.md
RELEASING.md
docs/DEVICE-TESTING-REQUIRED.md
docs/PRODUCTION-READINESS.md
docs/VIRO-ON-PICO.md
docs/example/
docs/release/
docs/validation/
