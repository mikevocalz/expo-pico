{
  "name": "@expo-pico/social",
  "version": "1.0.0",
  "description": "PICO OS social features for Expo",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js",
    "./plugin": {
      "import": "./plugin/build/src/index.js",
      "require": "./plugin/build/src/index.js",
      "types": "./plugin/build/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:plugin": "tsc --project plugin/tsconfig.json",
    "clean": "rm -rf build",
    "test": "jest --config jest.config.js",
    "prepare": "tsc && tsc --project plugin/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0"
  },
  "keywords": [
    "expo",
    "pico",
    "xr",
    "social",
    "friends",
    "presence"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mikevocalz/expo-pico.git",
    "directory": "packages/expo-pico-social"
  },
  "bugs": "https://github.com/your-org/expo-pico/issues",
  "license": "MIT",
  "homepage": "https://github.com/your-org/expo-pico/packages/expo-pico-social",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@expo-pico/platform-service-common": "^1.0.0"
  },
  "devDependencies": {
    "@expo-pico/core": "*",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "expo": ">=58.0.2 <59",
    "@expo-pico/core": ">=1.1.0",
    "react": ">=19.3.0 <20",
    "react-native": ">=0.88.0-rc.3 <0.89"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": false
    },
    "@expo-pico/core": {
      "optional": false
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-pico-social"
      ]
    }
  },
  "files": [
    "LICENSE",
    "build",
    "android",
    "plugin/build",
    "app.plugin.js"
  ]
}
