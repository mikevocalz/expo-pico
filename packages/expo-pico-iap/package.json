{
  "name": "@expo-pico/iap",
  "version": "1.0.0",
  "description": "PICO store in-app purchase APIs for Expo apps.",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/src/index.js",
      "require": "./build/src/index.js",
      "types": "./build/src/index.d.ts"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./plugin": {
      "import": "./plugin/build/src/withPicoIap.js",
      "require": "./plugin/build/src/withPicoIap.js",
      "types": "./plugin/build/src/withPicoIap.d.ts"
    }
  },
  "scripts": {
    "build": "nitrogen && tsc",
    "build:plugin": "tsc --project plugin/tsconfig.json",
    "clean": "rm -rf build nitrogen/generated",
    "test": "jest --config jest.config.js",
    "prepare": "nitrogen && tsc",
    "typecheck": "tsc --noEmit",
    "nitrogen": "nitrogen",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0"
  },
  "keywords": [
    "expo",
    "pico",
    "iap",
    "in-app-purchase",
    "pico-store"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mikevocalz/expo-pico.git",
    "directory": "packages/expo-pico-iap"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@expo-pico/platform-service-common": "^1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "expo": "~57.0.16",
    "@expo-pico/core": "*",
    "jest": "^29.7.0",
    "react-native": "0.86.2",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3",
    "react-native-nitro-modules": "^0.37.0",
    "nitrogen": "^0.37.0"
  },
  "peerDependencies": {
    "expo": "~57.0.16",
    "@expo-pico/core": ">=1.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": false
    },
    "@expo-pico/core": {
      "optional": false
    },
    "react-native-nitro-modules": {
      "optional": false
    }
  },
  "files": [
    "LICENSE",
    "build",
    "nitrogen/generated",
    "android",
    "plugin/build",
    "app.plugin.js",
    "nitro.json"
  ],
  "homepage": "https://github.com/mikevocalz/expo-pico/tree/main/packages/expo-pico-iap",
  "bugs": "https://github.com/mikevocalz/expo-pico/issues"
}
