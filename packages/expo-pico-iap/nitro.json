{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["expopico", "iap"],
  "ios": {
    "iosModuleName": "ExpoPicoIap"
  },
  "android": {
    "androidNamespace": ["expopico", "iap"],
    "androidCxxLibName": "ExpoPicoIap"
  },
  "autolinking": {
    "PicoIap": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPicoIap"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "build", "lib", "plugin"]
}
