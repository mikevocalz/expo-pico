{
  "name": "@expo-pico/app-kit",
  "version": "0.1.0",
  "description": "Orchestration layer for the expo-pico packages: boot probe, capability cache, and no-op-safe wrappers over the sibling modules.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./plugins/withPicoPostpatch": "./plugins/withPicoPostpatch.js",
    "./plugins/withPicoCompat": "./plugins/withPicoCompat.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc"
  },
  "files": [
    "LICENSE",
    "README.md",
    "build",
    "src",
    "plugins"
  ],
  "keywords": [
    "expo",
    "pico",
    "pps",
    "xr",
    "vr",
    "spatial"
  ],
  "license": "MIT",
  "peerDependencies": {
