{
  "name": "@expo-pico/spatial",
  "version": "1.0.0",
  "description": "Spatial mode helpers, container APIs, and runtime seams for PICO OS 6 Spatial SDK.",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/src/index.js",
      "require": "./build/src/index.js",
      "types": "./build/src/index.d.ts"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js",
    "./plugin": {
      "import": "./plugin/build/src/withPicoSpatial.js",
      "require": "./plugin/build/src/withPicoSpatial.js",
      "types": "./plugin/build/src/withPicoSpatial.d.ts"
    }
  },
  "scripts": {
    "build": "nitrogen && tsc",
    "build:plugin": "tsc --project plugin/tsconfig.json",
    "clean": "rm -rf build nitrogen/generated plugin/build",
    "test": "jest --config jest.config.js",
    "prepare": "nitrogen && tsc && tsc --project plugin/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "nitrogen": "nitrogen",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0"
  },
  "keywords": [
    "expo",
    "pico",
    "pico-os",
    "spatial",
    "xr",
    "vr",
    "mixed-reality"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mikevocalz/expo-pico.git",
    "directory": "packages/expo-pico-spatial"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@expo-pico/platform-service-common": "^1.0.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.0",
    "@types/react": "~19.2.14",
    "expo": "~57.0.16",
    "@expo-pico/core": "*",
    "jest": "^29.7.0",
    "react-native": "0.86.2",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3",
    "react-native-nitro-modules": "^0.37.0",
    "nitrogen": "^0.37.0"
  },
  "peerDependencies": {
    "expo": "~57.0.16",
    "@expo-pico/core": ">=1.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": false
    },
    "@expo-pico/core": {
      "optional": false
    },
    "react-native-nitro-modules": {
      "optional": false
    }
  },
  "files": [
    "LICENSE",
    "build",
    "nitrogen/generated",
    "android",
    "plugin/build",
    "app.plugin.js",
    "nitro.json"
  ],
  "homepage": "https://github.com/mikevocalz/expo-pico/tree/main/packages/expo-pico-spatial",
  "bugs": "https://github.com/mikevocalz/expo-pico/issues"
}
