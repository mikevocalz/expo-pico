{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["expopico", "achievements"],
  "ios": {
    "iosModuleName": "ExpoPicoAchievements"
  },
  "android": {
    "androidNamespace": ["expopico", "achievements"],
    "androidCxxLibName": "ExpoPicoAchievements"
  },
  "autolinking": {
    "PicoAchievements": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPicoAchievements"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "build", "lib", "plugin"]
}
