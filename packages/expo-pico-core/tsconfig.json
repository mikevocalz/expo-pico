{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./build",
    "rootDir": ".",
    "module": "node16",
    "moduleResolution": "node16",
    "resolvePackageJsonImports": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "plugin",
    "android",
    "__tests__",
    "src/__tests__"
  ]
}
