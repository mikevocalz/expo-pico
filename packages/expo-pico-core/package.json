{
  "name": "@expo-pico/core",
  "version": "0.2.0",
  "description": "Expo config plugin and runtime module for PICO OS 6 XR devices.",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/src/index.js",
      "require": "./build/src/index.js",
      "types": "./build/src/index.d.ts"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./plugin": {
      "import": "./plugin/build/withPico.js",
      "require": "./plugin/build/withPico.js",
      "types": "./plugin/build/withPico.d.ts"
    },
    "./plugin/viro": {
      "import": "./plugin/build/viro/index.js",
      "require": "./plugin/build/viro/index.js",
      "types": "./plugin/build/viro/index.d.ts"
    }
  },
  "bin": {
    "expo-pico-doctor": "./cli/build/doctor.js"
  },
  "scripts": {
    "build": "nitrogen && tsc",
    "build:plugin": "tsc --project plugin/tsconfig.json",
    "build:cli": "tsc --project cli/tsconfig.json && chmod +x cli/build/doctor.js",
    "clean": "rm -rf build nitrogen/generated plugin/build cli/build",
    "test": "jest --config jest.config.js",
    "prepare": "nitrogen && tsc && tsc --project plugin/tsconfig.json && tsc --project cli/tsconfig.json && chmod +x cli/build/doctor.js",
    "typecheck": "tsc --noEmit",
    "nitrogen": "nitrogen",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-pico",
    "pico",
    "pico-os",
    "xr",
    "spatial",
    "vr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mikevocalz/expo-pico.git",
    "directory": "packages/expo-pico-core"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@expo/config-plugins": "~57.0.9",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.0",
    "@types/react": "~19.2.14",
    "expo": "~57.0.16",
    "jest": "^29.7.0",
    "react-native": "^0.86.2",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3",
    "react-native-nitro-modules": "^0.37.0",
    "nitrogen": "^0.37.0"
  },
  "peerDependencies": {
    "expo": "~57.0.16",
    "react": "*",
    "react-native": "*",
    "expo-location": "*",
    "react-native-nitro-modules": ">=0.37.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": false
    },
    "expo-location": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": false
    }
  },
  "files": [
    "LICENSE",
    "build",
    "nitrogen/generated",
    "android",
    "cli/build",
    "plugin/build",
    "plugin/assets",
    "app.plugin.js",
    "nitro.json"
  ],
  "homepage": "https://github.com/mikevocalz/expo-pico/tree/main/packages/expo-pico-core",
  "bugs": "https://github.com/mikevocalz/expo-pico/issues"
}
