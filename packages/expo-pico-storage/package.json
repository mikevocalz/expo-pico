{
  "name": "@expo-pico/storage",
  "version": "1.0.0",
  "description": "PICO OS cloud storage for Expo",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js",
    "./plugin": {
      "import": "./plugin/build/src/index.js",
      "require": "./plugin/build/src/index.js",
      "types": "./plugin/build/src/index.d.ts"
    }
  },
  "scripts": {
    "build": "nitrogen && tsc",
    "build:plugin": "tsc --project plugin/tsconfig.json",
    "clean": "rm -rf build nitrogen/generated",
    "test": "jest --config jest.config.js",
    "prepare": "nitrogen && tsc && tsc --project plugin/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "nitrogen": "nitrogen"
  },
  "keywords": [
    "expo",
    "pico",
    "xr",
    "storage",
    "cloud-save"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mikevocalz/expo-pico.git",
    "directory": "packages/expo-pico-storage"
  },
  "bugs": "https://github.com/your-org/expo-pico/issues",
  "license": "MIT",
  "homepage": "https://github.com/your-org/expo-pico/packages/expo-pico-storage",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@expo-pico/platform-service-common": "^1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3",
    "nitrogen": "1.0.0-alpha.nightly.100.g107f6fc66597",
    "react-native-nitro-modules": "1.0.0-alpha.nightly.100.g107f6fc66597",
    "nitro-core": "1.0.0-alpha.nightly.100.g107f6fc66597"
  },
  "peerDependencies": {
    "expo": ">=58.0.0 <59",
    "@expo-pico/core": ">=1.0.0",
    "react": ">=19.3.0 <20",
    "react-native": ">=0.88.0 <0.89",
    "react-native-nitro-modules": "*",
    "nitro-core": "*"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": false
    },
    "@expo-pico/core": {
      "optional": false
    },
    "nitro-core": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": false
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "expo-pico-storage"
      ]
    }
  },
  "files": [
    "LICENSE",
    "build",
    "android",
    "plugin/build",
    "app.plugin.js",
    "nitrogen/generated",
    "nitro.json",
    "react-native.config.js"
  ],
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs"
  }
}
