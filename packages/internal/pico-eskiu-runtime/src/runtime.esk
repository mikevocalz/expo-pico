import <math>;

float expo_pico_clampf(float value, float lo, float hi) {
    if (value < lo) { return lo; }
    if (value > hi) { return hi; }
    return value;
}

int expo_pico_capability_enabled(uint64 declared, uint64 available, int bit) {
    if (bit < 0 || bit > 63) { return 0; }
    let mask: uint64 = ((uint64)1) << bit;
    if ((declared & mask) == 0) { return 0; }
    if ((available & mask) == 0) { return 0; }
    return 1;
}

float expo_pico_haptic_amplitude(float amplitude) {
    return expo_pico_clampf(amplitude, 0.0, 1.0);
}

float expo_pico_passthrough_level(float level) {
    return expo_pico_clampf(level, 0.0, 1.0);
}

uint32 expo_pico_viro_abi_version() {
    return 1;
}

uint64 expo_pico_viro_feature_mask(uint64 declared, uint64 available) {
    return declared & available;
}

float expo_pico_vec3_length_sq(float x, float y, float z) {
    return (x * x) + (y * y) + (z * z);
}

float expo_pico_quat_norm_sq(float x, float y, float z, float w) {
    return (x * x) + (y * y) + (z * z) + (w * w);
}


struct ExpoPicoVec3 {
    float x;
    float y;
    float z;
}

struct ExpoPicoQuat {
    float x;
    float y;
    float z;
    float w;
}

struct ExpoPicoByteView {
    *uint8 data;
    uint64 length;
}

struct ExpoPicoPosePacket {
    uint32 struct_size;
    uint32 flags;
    uint64 timestamp_ns;
    ExpoPicoVec3 position;
    ExpoPicoQuat rotation;
}

struct ExpoPicoPlanePacket {
    uint32 struct_size;
    uint32 flags;
    uint64 plane_id;
    ExpoPicoPosePacket pose;
    float extent_x;
    float extent_z;
    float confidence;
    float reserved;
}

struct ExpoPicoSceneMeshPacket {
    uint32 struct_size;
    uint32 flags;
    uint64 mesh_id;
    uint64 version;
    uint32 vertex_count;
    uint32 vertex_stride_bytes;
    uint32 index_count;
    uint32 index_stride_bytes;
    ExpoPicoByteView vertices;
    ExpoPicoByteView indices;
}

bool expo_pico_finite(float value) {
    if (value != value) { return false; }
    double magnitude = fabs((double)value);
    return magnitude <= 3.402823466e38;
}

uint32 expo_pico_viro_negotiate_version(uint32 requested_version) {
    if (requested_version == 0) { return 0; }
    if (requested_version < 1) { return requested_version; }
    return 1;
}

uint64 expo_pico_viro_capabilities() {
    return (((uint64)1) << 0) |
           (((uint64)1) << 1) |
           (((uint64)1) << 2) |
           (((uint64)1) << 3) |
           (((uint64)1) << 4);
}

int expo_pico_pose_packet_validate(*ExpoPicoPosePacket packet) {
    if (packet == null || packet.struct_size < 48) { return 0; }
    if (!expo_pico_finite(packet.position.x) ||
        !expo_pico_finite(packet.position.y) ||
        !expo_pico_finite(packet.position.z) ||
        !expo_pico_finite(packet.rotation.x) ||
        !expo_pico_finite(packet.rotation.y) ||
        !expo_pico_finite(packet.rotation.z) ||
        !expo_pico_finite(packet.rotation.w)) {
        return 0;
    }
    float n2 = expo_pico_quat_norm_sq(
        packet.rotation.x,
        packet.rotation.y,
        packet.rotation.z,
        packet.rotation.w);
    return n2 > 0.0 ? 1 : 0;
}

int expo_pico_plane_packet_validate(*ExpoPicoPlanePacket packet) {
    if (packet == null || packet.struct_size < 80) { return 0; }
    if (expo_pico_pose_packet_validate(&packet.pose) == 0) { return 0; }
    if (!expo_pico_finite(packet.extent_x) ||
        !expo_pico_finite(packet.extent_z) ||
        !expo_pico_finite(packet.confidence)) {
        return 0;
    }
    if (packet.extent_x < 0.0 || packet.extent_z < 0.0) { return 0; }
    return 1;
}

int expo_pico_scene_mesh_packet_validate(*ExpoPicoSceneMeshPacket packet) {
    if (packet == null || packet.struct_size < 72) { return 0; }
    if (packet.mesh_id == 0 || packet.version == 0) { return 0; }
    if (packet.vertex_count == 0 || packet.vertex_stride_bytes == 0) { return 0; }
    uint64 vertex_bytes =
        (uint64)packet.vertex_count * (uint64)packet.vertex_stride_bytes;
    if (packet.vertices.data == null || packet.vertices.length < vertex_bytes) { return 0; }
    if (packet.index_count > 0) {
        if (packet.index_stride_bytes != 2 && packet.index_stride_bytes != 4) { return 0; }
        uint64 index_bytes =
            (uint64)packet.index_count * (uint64)packet.index_stride_bytes;
        if (packet.indices.data == null || packet.indices.length < index_bytes) { return 0; }
    }
    return 1;
}
