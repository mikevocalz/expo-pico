{
  "name": "@expo-pico/platform-service-common",
  "version": "0.1.0",
  "description": "Shared error types, native-module resolution, and pagination helpers used by the @expo-pico/* packages. Published so those packages install standalone; not a stable public API.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "require": "./build/index.js",
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./testing": {
      "require": "./build/testing/contractFactory.js",
      "import": "./build/testing/contractFactory.js",
      "types": "./build/testing/contractFactory.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./build/testing/contractFactory.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf build",
    "test": "jest"
  },
  "peerDependencies": {
    "react-native-nitro-modules": ">=0.37.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "~6.0.3",
    "react-native-nitro-modules": "^0.37.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikevocalz/expo-pico.git",
    "directory": "packages/internal/pico-platform-service-common"
  },
  "homepage": "https://github.com/mikevocalz/expo-pico/tree/main/packages/internal/pico-platform-service-common",
  "bugs": "https://github.com/mikevocalz/expo-pico/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "LICENSE",
    "README.md",
    "build"
  ]
}
