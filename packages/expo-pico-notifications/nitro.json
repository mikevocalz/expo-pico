{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["expopico", "notifications"],
  "ios": {
    "iosModuleName": "ExpoPicoNotifications"
  },
  "android": {
    "androidNamespace": ["expopico", "notifications"],
    "androidCxxLibName": "ExpoPicoNotifications"
  },
  "autolinking": {
    "PicoNotifications": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPicoNotifications"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "build", "lib", "plugin"]
}
