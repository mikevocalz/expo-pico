{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "expopico",
    "subscription"
  ],
  "ios": {
    "iosModuleName": "ExpoPicoSubscription"
  },
  "android": {
    "androidNamespace": [
      "expopico",
      "subscription"
    ],
    "androidCxxLibName": "ExpoPicoSubscription"
  },
  "autolinking": {
    "PicoSubscription": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPicoSubscription"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules",
    "build",
    "lib",
    "plugin"
  ]
}
